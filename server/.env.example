# Fenix server — variables de entorno
# Copia este archivo a ".env" y rellena tus valores. NUNCA subas ".env" a Git.

# --- Servidor ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
# En producción, Render/Railway te dan esta URL. En local, si la dejas vacía,
# el servidor usa Postgres EN MEMORIA (pg-mem): arranca igual para probar.
DATABASE_URL=

# --- Sesión del panel de administrador (solo tú) ---
# Pon una cadena larga y aleatoria. Ej: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Usuario admin que se crea al arrancar (cámbialo antes de desplegar).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Pagos (Stripe) ---
# Deja vacío para modo DEMO (no cobra). Rellena para cobrar de verdad.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Proveedor (dropshipping) ---
# none | cjdropshipping | zendrop   (cjdropshipping/zendrop = stub, listo para tu API key)
SUPPLIER_PROVIDER=none
SUPPLIER_API_KEY=

# --- Finanzas (comisiones de la pasarela para calcular tu beneficio neto) ---
FEE_PERCENT=2.9
FEE_FIXED_CENTS=30
